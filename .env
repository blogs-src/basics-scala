APP_CONFIG_FILE="application-kafka.conf"
# APP_CONFIG_FILE="application-sharding.conf"
# APP_CONFIG_FILE="application.conf"

#SCENARIO=scenario3
SCENARIO=scenario1

COURSIER_TTL=0s

# OTEL_TRACES_EXPORTER=logging
# OTEL_LOGS_EXPORTER=logging

OTEL_TRACES_EXPORTER=none
OTEL_LOGS_EXPORTER=none

OTEL_PROPAGATORS=tracecontext,baggage
#OTEL_PROPAGATORS=tracecontext,baggage,jaeger

OTEL_SERVICE_NAME=scala-basics
OTEL_METRICS_EXPORTER=prometheus
OTEL_EXPORTER_PROMETHEUS_PORT=8888
OTEL_EXPORTER_PROMETHEUS_HOST=0.0.0.0

SBT_LAUNCH_REPO="http://localhost:8080/releases"
