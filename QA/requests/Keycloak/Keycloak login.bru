meta {
  name: Keycloak login
  type: http
  seq: 1
}

post {
  url: {{keycloak-base-url}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: inherit
}

body:form-urlencoded {
  client_id: trinity-api
  client_secret: some-secret1
  username: test
  password: test
  grant_type: password
}

vars:pre-request {
  realm: trinity
}

script:post-response {
  if(res.body.access_token) {
      bru.setVar("token", res.body.access_token)
  }
}
